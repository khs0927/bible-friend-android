{
  "name": "bible-friend",
  "private": true,
  "version": "0.1.0",
  "description": "성경 친구 — 어린이를 위한 AI 성경 친구 앱 (Expo + Supabase)",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "android": "pnpm --filter mobile android",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "pnpm sync:core --check && turbo run typecheck lint test && pnpm functions:test",
    "sync:core": "node scripts/sync-core.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > apps/mobile/src/lib/database.types.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "functions:check": "deno check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke-local.mjs",
    "db:test": "supabase test db",
    "android:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-setup.ps1",
    "android:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-dev.ps1",
    "functions:test": "deno test --config supabase/functions/deno.json supabase/functions/_shared/",
    "smoke:voice": "node scripts/smoke-voice.mjs",
    "voice:smoke": "node services/voice-cpu/smoke.mjs",
    "figma:export": "node scripts/figma-export.mjs",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "rust:check": "cargo fmt --manifest-path rust/Cargo.toml --all --check && cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
    "rust:sync-web": "node scripts/sync-web.mjs",
    "rust:android:init": "cd rust/apps/bible-friend && cargo tauri android init",
    "rust:android:dev": "cd rust/apps/bible-friend && cargo tauri android dev",
    "rust:android:build": "node scripts/sync-web.mjs && cd rust/apps/bible-friend && cargo tauri android build --apk"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "prettier": "^3.6.2",
    "supabase": "^2.118.0",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3",
    "@supabase/supabase-js": "^2.110.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "deno",
      "esbuild",
      "supabase",
      "unrs-resolver"
    ]
  }
}
