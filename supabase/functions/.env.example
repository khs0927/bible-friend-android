# Secrets for Edge Functions.
# Local:  cp supabase/functions/.env.example supabase/functions/.env  (then `pnpm functions:serve`)
# Hosted: supabase secrets set --env-file supabase/functions/.env
#
# Every capability is a provider chain; configure any subset. Order = preference.
#   TTS  Gemini TTS models → Qwen3-TTS (GPU) → Supertonic 3 (CPU) → app's on-device voice
#   STT  Gemini models → faster-whisper (CPU)
#   Chat Gemini models → open-weight LLM (OpenAI-compatible) → safe canned answer

# --- Gemini --------------------------------------------------------------------
GEMINI_API_KEY=
# Comma-separated, tried in order. Different models have separate free-tier quotas.
GEMINI_CHAT_MODELS=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
GEMINI_STT_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# --- Open-source voice, CPU (services/voice-cpu: Supertonic 3 + faster-whisper) ---
# Local Docker functions reach the host through host.docker.internal.
VOICE_CPU_URL=http://host.docker.internal:8808
VOICE_API_KEY=

# --- Open-source TTS, GPU (optional; services/voice-gpu: Qwen3-TTS via vLLM-Omni) --
QWEN_TTS_URL=
QWEN_TTS_API_KEY=
QWEN_TTS_VOICE=sohee

# --- Open-weight chat model (optional; Ollama / vLLM / OpenRouter …) ---------------
# e.g. OSS_LLM_URL=http://host.docker.internal:11434  OSS_LLM_MODEL=qwen3:8b
OSS_LLM_URL=
OSS_LLM_MODEL=
OSS_LLM_API_KEY=
